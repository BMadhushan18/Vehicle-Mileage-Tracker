{
  "name": "ridelog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RideLog - bike mileage and fuel tracker on Cloudflare Pages + D1",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8790",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler pages dev --port 8790",
    "typecheck": "tsc -p tsconfig.json && tsc -p functions/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate:local": "wrangler d1 migrations apply ridelog-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ridelog-db --remote",
    "db:seed:local": "wrangler d1 execute ridelog-db --local --file=seed/seed.sql",
    "seed:make": "node scripts/make-seed.mjs",
    "build:android": "npm run typecheck && vite build --mode android && cap sync android",
    "cap:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/local-notifications": "^6.1.3",
    "chart.js": "^4.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@cloudflare/workers-types": "^4.20241205.0",
    "@eslint/js": "^9.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^3.95.0"
  }
}
